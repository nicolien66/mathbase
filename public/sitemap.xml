<!--
  Polymates — plan du site pour les moteurs de recherche.

  À placer dans public/ : Express le sert alors à
  https://mathbase-production.up.railway.app/sitemap.xml

  IMPORTANT — le domaine doit correspondre EXACTEMENT à la propriété déclarée
  dans la Search Console. Google refuse tout sitemap dont les URL sortent du
  domaine vérifié. Le jour où polymates.fr sera branché, il faudra déclarer une
  nouvelle propriété, puis remplacer le domaine ici et dans robots.txt.

  Seules les pages réellement publiques figurent ici. Les espaces de travail
  sont derrière une authentification : les déclarer ferait remonter des erreurs
  dans la Search Console sans apporter la moindre visibilité.
  presentation.html porte le contenu indexable du site ; c'est la page par
  laquelle un moteur comprendra ce qu'est Polymates.

  Pense à mettre à jour <lastmod> quand la page change réellement : une date
  fausse apprend à Google à ignorer le champ.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://mathbase-production.up.railway.app/</loc>
    <lastmod>2026-09-07</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://mathbase-production.up.railway.app/presentation.html</loc>
    <lastmod>2026-09-08</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

